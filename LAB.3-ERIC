                <li><a href="https://validator.w3.org/" target="_blank">W3C Validator</a></li> 

            </ul> 

 

            <!-- 2.2.3 Scripting y Soporte --> 

            <h3>Estado del Sistema</h3> 

            <script> 

                document.write("<p><small>Fecha local: " + new Date().toLocaleDateString('es-PA') + "</small></p>"); 

            </script> 

            <noscript> 

                <p style="color: red;"><small>⚠️ Su navegador no tiene JavaScript habilitado.</small></p> 

            </noscript> 

        </aside> 

